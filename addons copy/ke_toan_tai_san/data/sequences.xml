<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequences for Thu Chi -->
    <record id="seq_phieu_thu" model="ir.sequence">
        <field name="name">Phiếu thu</field>
        <field name="code">ke_toan.phieu_thu</field>
        <field name="prefix">PT-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_phieu_chi" model="ir.sequence">
        <field name="name">Phiếu chi</field>
        <field name="code">ke_toan.phieu_chi</field>
        <field name="prefix">PC-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Sequences for Công nợ -->
    <record id="seq_phai_thu" model="ir.sequence">
        <field name="name">Công nợ phải thu</field>
        <field name="code">ke_toan.phai_thu</field>
        <field name="prefix">PT-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_phai_tra" model="ir.sequence">
        <field name="name">Công nợ phải trả</field>
        <field name="code">ke_toan.phai_tra</field>
        <field name="prefix">PTR-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Sequence for Hóa đơn -->
    <record id="seq_hoa_don" model="ir.sequence">
        <field name="name">Hóa đơn</field>
        <field name="code">ke_toan.hoa_don</field>
        <field name="prefix">HD-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>
