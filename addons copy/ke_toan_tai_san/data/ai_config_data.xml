<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default AI Configuration -->
        <record id="ai_config_default" model="ai.config">
            <field name="name">Default AI Configuration</field>
            <field name="is_active">True</field>
            <field name="openrouter_api_key">your-openrouter-api-key-here</field>
            <field name="openrouter_model">xiaomi/mimo-v2-flash:free</field>
            <field name="max_conversation_length">50</field>
            <field name="max_response_tokens">1000</field>
            <field name="temperature">0.7</field>
            <field name="enable_asset_search">True</field>
            <field name="enable_employee_search">True</field>
            <field name="enable_room_booking">True</field>
            <field name="enable_analytics">True</field>
        </record>

        <!-- System Parameter for API Key -->
        <record id="ir_config_parameter_openrouter_api_key" model="ir.config_parameter">
            <field name="key">openrouter.api_key</field>
            <field name="value">your-openrouter-api-key-here</field>
        </record>
    </data>
</odoo>