<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_bao_tri_phong_hop_tree" model="ir.ui.view">
        <field name="name">bao.tri.phong.hop.tree</field>
        <field name="model">bao_tri_phong_hop</field>
        <field name="arch" type="xml">
            <tree string="Bảo trì phòng họp">
                <field name="ma_bao_tri"/>
                <field name="phong_hop_id"/>
                <field name="loai_bao_tri"/>
                <field name="ngay_bat_dau"/>
                <field name="ngay_ket_thuc"/>
                <field name="chi_phi" widget="monetary"/>
                <field name="nguoi_thuc_hien_id"/>
                <field name="trang_thai" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bao_tri_phong_hop_form" model="ir.ui.view">
        <field name="name">bao.tri.phong.hop.form</field>
        <field name="model">bao_tri_phong_hop</field>
        <field name="arch" type="xml">
            <form string="Bảo trì phòng họp">
                <header>
                    <button name="action_bat_dau" string="Bắt đầu" type="object" attrs="{'invisible': [('trang_thai', '!=', 'ke_hoach')]}" class="oe_highlight"/>
                    <button name="action_hoan_thanh" string="Hoàn thành" type="object" attrs="{'invisible': [('trang_thai', '!=', 'dang_thuc_hien')]}" class="oe_highlight"/>
                    <button name="action_huy" string="Hủy" type="object" attrs="{'invisible': [('trang_thai', 'not in', ['ke_hoach','dang_thuc_hien'])]}"/>
                    <field name="trang_thai" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ma_bao_tri" readonly="1"/>
                            <field name="phong_hop_id"/>
                            <field name="loai_bao_tri"/>
                        </group>
                        <group>
                            <field name="ngay_bat_dau"/>
                            <field name="ngay_ket_thuc"/>
                            <field name="nguoi_thuc_hien_id"/>
                            <field name="chi_phi" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nội dung">
                            <field name="noi_dung" placeholder="Mô tả công việc bảo trì..."/>
                        </page>
                        <page string="Kết quả">
                            <field name="ket_qua" placeholder="Kết quả sau bảo trì..."/>
                        </page>
                        <page string="Ghi chú">
                            <field name="ghi_chu"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bao_tri_phong_hop" model="ir.actions.act_window">
        <field name="name">Bảo trì phòng họp</field>
        <field name="res_model">bao_tri_phong_hop</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu will be added in menu.xml -->
</odoo>
