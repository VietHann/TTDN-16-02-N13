<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_phong_hop_tree" model="ir.ui.view">
        <field name="name">phong.hop.tree</field>
        <field name="model">phong_hop</field>
        <field name="arch" type="xml">
            <tree string="Phòng họp" decoration-success="trang_thai=='san_sang'" decoration-warning="trang_thai=='dang_su_dung'">
                <field name="ma_phong"/>
                <field name="ten_phong"/>
                <field name="vi_tri_id"/>
                <field name="suc_chua"/>
                <field name="dien_tich"/>
                <field name="trang_thai" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_phong_hop_form" model="ir.ui.view">
        <field name="name">phong.hop.form</field>
        <field name="model">phong_hop</field>
        <field name="arch" type="xml">
            <form string="Phòng họp">
                <header>
                    <button name="action_bao_tri" string="Bảo trì" type="object" class="oe_highlight"/>
                    <button name="action_nang_cap" string="Nâng cấp" type="object"/>
                    <button name="action_xem_lich_dat_phong" string="Xem lịch đặt" type="object"/>
                    <field name="trang_thai" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="hinh_anh" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="ten_phong" placeholder="Tên phòng họp"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ma_phong"/>
                            <field name="vi_tri_id"/>
                            <field name="suc_chua"/>
                        </group>
                        <group>
                            <field name="dien_tich"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thiết bị">
                            <field name="thiet_bi_ids">
                                <tree>
                                    <field name="ma_tai_san"/>
                                    <field name="ten_tai_san"/>
                                    <field name="loai_tai_san_id"/>
                                    <field name="trang_thai"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Lịch đặt phòng">
                            <field name="dat_phong_ids">
                                <tree>
                                    <field name="ma_dat_phong"/>
                                    <field name="tieu_de"/>
                                    <field name="nguoi_dat_id"/>
                                    <field name="ngay_bat_dau"/>
                                    <field name="ngay_ket_thuc"/>
                                    <field name="trang_thai" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Bảo trì">
                            <field name="bao_tri_ids">
                                <tree>
                                    <field name="ma_bao_tri"/>
                                    <field name="loai_bao_tri"/>
                                    <field name="ngay_bat_dau"/>
                                    <field name="ngay_ket_thuc"/>
                                    <field name="chi_phi" widget="monetary"/>
                                    <field name="trang_thai" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Nâng cấp">
                            <field name="nang_cap_ids">
                                <tree>
                                    <field name="ma_nang_cap"/>
                                    <field name="loai_nang_cap"/>
                                    <field name="ngay_nang_cap"/>
                                    <field name="chi_phi_thuc_te" widget="monetary"/>
                                    <field name="trang_thai" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Mô tả">
                            <field name="mo_ta" placeholder="Mô tả chi tiết phòng họp..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_phong_hop_search" model="ir.ui.view">
        <field name="name">phong.hop.search</field>
        <field name="model">phong_hop</field>
        <field name="arch" type="xml">
            <search string="Tìm phòng họp">
                <field name="ma_phong"/>
                <field name="ten_phong"/>
                <field name="vi_tri_id"/>
                <filter string="Sẵn sàng" name="san_sang" domain="[('trang_thai','=','san_sang')]"/>
                <filter string="Đang sử dụng" name="dang_su_dung" domain="[('trang_thai','=','dang_su_dung')]"/>
                <filter string="Bảo trì" name="bao_tri" domain="[('trang_thai','=','bao_tri')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Vị trí" name="group_vi_tri" context="{'group_by':'vi_tri_id'}"/>
                    <filter string="Trạng thái" name="group_trang_thai" context="{'group_by':'trang_thai'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_phong_hop" model="ir.actions.act_window">
        <field name="name">Phòng họp</field>
        <field name="res_model">phong_hop</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu will be added in menu.xml -->
</odoo>
