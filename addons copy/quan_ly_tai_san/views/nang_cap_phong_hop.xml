<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_nang_cap_phong_hop_tree" model="ir.ui.view">
        <field name="name">nang.cap.phong.hop.tree</field>
        <field name="model">nang_cap_phong_hop</field>
        <field name="arch" type="xml">
            <tree string="Nâng cấp phòng họp">
                <field name="ma_nang_cap"/>
                <field name="phong_hop_id"/>
                <field name="loai_nang_cap"/>
                <field name="ngay_nang_cap"/>
                <field name="chi_phi_du_kien" widget="monetary"/>
                <field name="chi_phi_thuc_te" widget="monetary"/>
                <field name="nguoi_de_xuat_id"/>
                <field name="trang_thai" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_nang_cap_phong_hop_form" model="ir.ui.view">
        <field name="name">nang.cap.phong.hop.form</field>
        <field name="model">nang_cap_phong_hop</field>
        <field name="arch" type="xml">
            <form string="Nâng cấp phòng họp">
                <header>
                    <button name="action_duyet" string="Duyệt" type="object" attrs="{'invisible': [('trang_thai', '!=', 'de_xuat')]}" class="oe_highlight"/>
                    <button name="action_tu_choi" string="Từ chối" type="object" attrs="{'invisible': [('trang_thai', '!=', 'de_xuat')]}"/>
                    <button name="action_bat_dau" string="Bắt đầu" type="object" attrs="{'invisible': [('trang_thai', '!=', 'da_duyet')]}" class="oe_highlight"/>
                    <button name="action_hoan_thanh" string="Hoàn thành" type="object" attrs="{'invisible': [('trang_thai', '!=', 'dang_thuc_hien')]}" class="oe_highlight"/>
                    <field name="trang_thai" widget="statusbar" statusbar_visible="de_xuat,da_duyet,dang_thuc_hien,hoan_thanh"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ma_nang_cap" readonly="1"/>
                            <field name="phong_hop_id"/>
                            <field name="loai_nang_cap"/>
                            <field name="ngay_nang_cap"/>
                        </group>
                        <group>
                            <field name="nguoi_de_xuat_id"/>
                            <field name="nguoi_duyet_id" readonly="1"/>
                            <field name="nguoi_thuc_hien_id"/>
                            <field name="nha_cung_cap_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="chi_phi_du_kien" widget="monetary"/>
                        </group>
                        <group>
                            <field name="chi_phi_thuc_te" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Nội dung">
                            <field name="noi_dung" placeholder="Mô tả chi tiết công việc nâng cấp..."/>
                        </page>
                        <page string="Lý do">
                            <field name="ly_do" placeholder="Lý do cần nâng cấp..."/>
                        </page>
                        <page string="Thiết bị mới">
                            <field name="thiet_bi_moi_ids">
                                <tree>
                                    <field name="ma_tai_san"/>
                                    <field name="ten_tai_san"/>
                                    <field name="loai_tai_san_id"/>
                                    <field name="gia_tien_mua" widget="monetary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Kết quả">
                            <field name="ket_qua" placeholder="Kết quả sau nâng cấp..."/>
                        </page>
                        <page string="Ghi chú">
                            <field name="ghi_chu"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_nang_cap_phong_hop" model="ir.actions.act_window">
        <field name="name">Nâng cấp phòng họp</field>
        <field name="res_model">nang_cap_phong_hop</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu will be added in menu.xml -->
</odoo>
