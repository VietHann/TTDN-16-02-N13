<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_phieu_nhap_hang_tree" model="ir.ui.view">
        <field name="name">phieu.nhap.hang.tree</field>
        <field name="model">phieu_nhap_hang</field>
        <field name="arch" type="xml">
            <tree string="Phiếu nhập hàng" decoration-info="trang_thai=='nhap'" decoration-success="trang_thai=='hoan_thanh'">
                <field name="ma_phieu"/>
                <field name="ngay_nhap"/>
                <field name="nha_cung_cap_id"/>
                <field name="tong_so_luong"/>
                <field name="tong_tien" widget="monetary"/>
                <field name="trang_thai" widget="badge" decoration-info="trang_thai=='nhap'" decoration-warning="trang_thai=='cho_duyet'" decoration-success="trang_thai in ['da_duyet','hoan_thanh']"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_phieu_nhap_hang_form" model="ir.ui.view">
        <field name="name">phieu.nhap.hang.form</field>
        <field name="model">phieu_nhap_hang</field>
        <field name="arch" type="xml">
            <form string="Phiếu nhập hàng">
                <header>
                    <button name="action_gui_duyet" string="Gửi duyệt" type="object" attrs="{'invisible': [('trang_thai', '!=', 'nhap')]}" class="oe_highlight"/>
                    <button name="action_duyet" string="Duyệt" type="object" attrs="{'invisible': [('trang_thai', '!=', 'cho_duyet')]}" class="oe_highlight"/>
                    <button name="action_nhap_kho" string="Nhập kho" type="object" attrs="{'invisible': [('trang_thai', '!=', 'da_duyet')]}" class="oe_highlight"/>
                    <button name="action_huy" string="Hủy" type="object" attrs="{'invisible': [('trang_thai', 'not in', ['nhap','cho_duyet','da_duyet'])]}" confirm="Bạn có chắc muốn hủy phiếu này?"/>
                    <field name="trang_thai" widget="statusbar" statusbar_visible="nhap,cho_duyet,da_duyet,hoan_thanh"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ma_phieu" readonly="1"/>
                            <field name="ngay_nhap"/>
                            <field name="nha_cung_cap_id"/>
                        </group>
                        <group>
                            <field name="nguoi_lap_id"/>
                            <field name="nguoi_duyet_id" readonly="1"/>
                            <field name="ngay_duyet" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết nhập hàng">
                            <field name="chi_tiet_ids">
                                <tree editable="bottom">
                                    <field name="loai_tai_san_id"/>
                                    <field name="ten_tai_san"/>
                                    <field name="so_serial_bat_dau"/>
                                    <field name="so_luong"/>
                                    <field name="don_gia" widget="monetary"/>
                                    <field name="thanh_tien" widget="monetary" sum="Tổng"/>
                                    <field name="ghi_chu"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="tong_so_luong"/>
                                <field name="tong_tien" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Ghi chú">
                            <field name="ghi_chu" placeholder="Ghi chú thêm..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_phieu_nhap_hang_search" model="ir.ui.view">
        <field name="name">phieu.nhap.hang.search</field>
        <field name="model">phieu_nhap_hang</field>
        <field name="arch" type="xml">
            <search string="Tìm phiếu nhập hàng">
                <field name="ma_phieu"/>
                <field name="nha_cung_cap_id"/>
                <filter string="Nháp" name="nhap" domain="[('trang_thai','=','nhap')]"/>
                <filter string="Chờ duyệt" name="cho_duyet" domain="[('trang_thai','=','cho_duyet')]"/>
                <filter string="Đã duyệt" name="da_duyet" domain="[('trang_thai','=','da_duyet')]"/>
                <filter string="Hoàn thành" name="hoan_thanh" domain="[('trang_thai','=','hoan_thanh')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhà cung cấp" name="group_nha_cung_cap" context="{'group_by':'nha_cung_cap_id'}"/>
                    <filter string="Trạng thái" name="group_trang_thai" context="{'group_by':'trang_thai'}"/>
                    <filter string="Ngày nhập" name="group_ngay_nhap" context="{'group_by':'ngay_nhap'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_phieu_nhap_hang" model="ir.actions.act_window">
        <field name="name">Phiếu nhập hàng</field>
        <field name="res_model">phieu_nhap_hang</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo phiếu nhập hàng mới
            </p>
        </field>
    </record>

    <!-- Menu will be added in menu.xml -->
</odoo>
