<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hoa_don_tree" model="ir.ui.view">
        <field name="name">ke.toan.hoa.don.tree</field>
        <field name="model">ke_toan.hoa_don</field>
        <field name="arch" type="xml">
            <tree string="Hóa đơn">
                <field name="so_hoa_don"/>
                <field name="loai_hoa_don"/>
                <field name="ngay_lap"/>
                <field name="khach_hang"/>
                <field name="tong_tien_hang" widget="monetary"/>
                <field name="tien_thue" widget="monetary"/>
                <field name="tong_thanh_toan" widget="monetary"/>
                <field name="trang_thai" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_hoa_don_form" model="ir.ui.view">
        <field name="name">ke.toan.hoa.don.form</field>
        <field name="model">ke_toan.hoa_don</field>
        <field name="arch" type="xml">
            <form string="Hóa đơn">
                <header>
                    <button name="action_xac_nhan" string="Xác nhận" type="object" attrs="{'invisible': [('trang_thai', '!=', 'nhap')]}" class="oe_highlight"/>
                    <button name="action_thanh_toan" string="Thanh toán" type="object" attrs="{'invisible': [('trang_thai', '!=', 'da_xac_nhan')]}" class="oe_highlight"/>
                    <button name="action_huy" string="Hủy" type="object" attrs="{'invisible': [('trang_thai', 'not in', ['nhap','da_xac_nhan'])]}"/>
                    <field name="trang_thai" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="so_hoa_don" readonly="1"/>
                            <field name="loai_hoa_don"/>
                            <field name="ngay_lap"/>
                        </group>
                        <group>
                            <field name="khach_hang"/>
                            <field name="ma_so_thue"/>
                            <field name="nguoi_lap_id"/>
                        </group>
                    </group>
                    <field name="dia_chi" placeholder="Địa chỉ..."/>
                    <notebook>
                        <page string="Chi tiết">
                            <field name="chi_tiet_ids">
                                <tree editable="bottom">
                                    <field name="ten_hang_hoa"/>
                                    <field name="don_vi_tinh"/>
                                    <field name="so_luong"/>
                                    <field name="don_gia" widget="monetary"/>
                                    <field name="thanh_tien" widget="monetary" sum="Tổng"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="tong_tien_hang" widget="monetary"/>
                                <field name="ty_le_thue"/>
                                <field name="tien_thue" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator">
                                    <label for="tong_thanh_toan"/>
                                    <field name="tong_thanh_toan" widget="monetary" class="oe_subtotal_footer_separator"/>
                                </div>
                            </group>
                        </page>
                        <page string="Công nợ">
                            <field name="cong_no_id" readonly="1"/>
                        </page>
                        <page string="Ghi chú">
                            <field name="ghi_chu"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_hoa_don" model="ir.actions.act_window">
        <field name="name">Hóa đơn</field>
        <field name="res_model">ke_toan.hoa_don</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu will be added in menu.xml -->
</odoo>
