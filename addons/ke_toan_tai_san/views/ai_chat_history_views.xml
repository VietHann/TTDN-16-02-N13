<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Chat History Views -->
    <record id="ai_chat_history_form_view" model="ir.ui.view">
        <field name="name">ai.chat.history.form</field>
        <field name="model">ai.chat.history</field>
        <field name="arch" type="xml">
            <form string="Lịch sử Chat AI">
                <sheet>
                    <div class="oe_title">
                        <label for="conversation_id" class="oe_edit_only"/>
                        <h1>
                            <field name="conversation_id" placeholder="ID cuộc trò chuyện"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="message_type"/>
                            <field name="user_id"/>
                            <field name="create_date" readonly="1"/>
                            <field name="ip_address" readonly="1"/>
                        </group>

                        <group>
                            <field name="message_length" readonly="1"/>
                            <field name="response_time"/>
                            <field name="user_rating"/>
                        </group>
                    </group>

                    <group string="Nội dung tin nhắn" colspan="4">
                        <field name="message" widget="text" nolabel="1" readonly="1"/>
                    </group>

                    <group string="Liên kết" colspan="4">
                        <field name="related_tai_san_ids" widget="many2many_tags"/>
                        <field name="related_nhan_vien_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_chat_history_tree_view" model="ir.ui.view">
        <field name="name">ai.chat.history.tree</field>
        <field name="model">ai.chat.history</field>
        <field name="arch" type="xml">
            <tree string="Lịch sử Chat AI" default_order="create_date desc">
                <field name="conversation_id"/>
                <field name="message_type"/>
                <field name="message" width="300"/>
                <field name="user_id"/>
                <field name="create_date"/>
                <field name="message_length"/>
                <field name="user_rating"/>
            </tree>
        </field>
    </record>

    <record id="ai_chat_history_search_view" model="ir.ui.view">
        <field name="name">ai.chat.history.search</field>
        <field name="model">ai.chat.history</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm lịch sử chat">
                <field name="conversation_id"/>
                <field name="message"/>
                <field name="user_id"/>
                <field name="message_type"/>
                <field name="create_date"/>

                <filter string="Hôm nay" name="today" domain="[('create_date', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('create_date', '&lt;', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="Tuần này" name="week" domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Tháng này" name="month" domain="[('create_date', '>=', (context_today().replace(day=1)).strftime('%Y-%m-%d 00:00:00'))]"/>

                <filter string="User Messages" name="user_messages" domain="[('message_type', '=', 'user')]"/>
                <filter string="AI Messages" name="ai_messages" domain="[('message_type', '=', 'assistant')]"/>
                <filter string="System Messages" name="system_messages" domain="[('message_type', '=', 'system')]"/>

                <group expand="0" string="Nhóm theo">
                    <filter string="Cuộc trò chuyện" name="conversation" context="{'group_by': 'conversation_id'}"/>
                    <filter string="Loại tin nhắn" name="message_type" context="{'group_by': 'message_type'}"/>
                    <filter string="Người dùng" name="user" context="{'group_by': 'user_id'}"/>
                    <filter string="Ngày" name="date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_chat_history_action" model="ir.actions.act_window">
        <field name="name">Lịch sử Chat AI</field>
        <field name="res_model">ai.chat.history</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="ai_chat_history_search_view"/>
        <field name="help">Xem lịch sử các cuộc trò chuyện với AI Assistant</field>
    </record>

</odoo>