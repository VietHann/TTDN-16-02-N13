<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cong_no_tree" model="ir.ui.view">
        <field name="name">ke.toan.cong.no.tree</field>
        <field name="model">ke_toan.cong_no</field>
        <field name="arch" type="xml">
            <tree string="Công nợ" decoration-danger="trang_thai=='qua_han'">
                <field name="ma_cong_no"/>
                <field name="loai_cong_no" widget="badge"/>
                <field name="doi_tuong"/>
                <field name="ngay_phat_sinh"/>
                <field name="ngay_den_han"/>
                <field name="so_tien_goc" widget="monetary"/>
                <field name="so_tien_con_lai" widget="monetary"/>
                <field name="trang_thai" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_cong_no_form" model="ir.ui.view">
        <field name="name">ke.toan.cong.no.form</field>
        <field name="model">ke_toan.cong_no</field>
        <field name="arch" type="xml">
            <form string="Công nợ">
                <header>
                    <button name="action_thanh_toan" string="Thanh toán" type="object" class="oe_highlight"/>
                    <field name="trang_thai" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ma_cong_no" readonly="1"/>
                            <field name="loai_cong_no"/>
                            <field name="doi_tuong"/>
                            <field name="nha_cung_cap_id"/>
                        </group>
                        <group>
                            <field name="ngay_phat_sinh"/>
                            <field name="ngay_den_han"/>
                            <field name="nguoi_phu_trach_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="so_tien_goc" widget="monetary"/>
                            <field name="so_tien_da_tra" widget="monetary"/>
                        </group>
                        <group>
                            <field name="so_tien_con_lai" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch sử thanh toán">
                            <field name="thanh_toan_ids">
                                <tree>
                                    <field name="ngay_thanh_toan"/>
                                    <field name="so_tien" widget="monetary" sum="Tổng"/>
                                    <field name="phuong_thuc"/>
                                    <field name="nguoi_thanh_toan_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Nội dung">
                            <field name="noi_dung"/>
                        </page>
                        <page string="Ghi chú">
                            <field name="ghi_chu"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cong_no" model="ir.actions.act_window">
        <field name="name">Công nợ</field>
        <field name="res_model">ke_toan.cong_no</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu will be added in menu.xml -->
</odoo>
