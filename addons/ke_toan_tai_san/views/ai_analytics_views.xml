<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_ai_analytics_tree" model="ir.ui.view">
        <field name="name">ai.tai.san.analytics.tree</field>
        <field name="model">ai.tai_san.analytics</field>
        <field name="arch" type="xml">
            <tree string="Phân tích Hiệu quả">
                <field name="name"/>
                <field name="ngay_phan_tich"/>
                <field name="tong_tai_san"/>
                <field name="tong_gia_tri" sum="Tổng" widget="monetary"/>
                <field name="ty_le_hieu_qua_tb"/>
                <field name="state" widget="badge" decoration-success="state=='done'"/>
            </tree>
        </field>
    </record>
    
    <record id="view_ai_analytics_form" model="ir.ui.view">
        <field name="name">ai.tai.san.analytics.form</field>
        <field name="model">ai.tai_san.analytics</field>
        <field name="arch" type="xml">
            <form string="Phân tích Hiệu quả">
                <header>
                    <button name="action_analyze" string="Phân tích" type="object" class="oe_highlight" states="draft"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="ngay_phan_tich"/>
                        </group>
                        <group>
                            <field name="tong_tai_san"/>
                            <field name="tong_gia_tri" widget="monetary"/>
                            <field name="tong_chi_phi_bao_tri" widget="monetary"/>
                            <field name="ty_le_hieu_qua_tb"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Top Hiệu quả Cao">
                            <field name="tai_san_hieu_qua_cao_ids">
                                <tree>
                                    <field name="ma_tai_san"/>
                                    <field name="ten_tai_san"/>
                                    <field name="loai_tai_san_id"/>
                                    <field name="gia_tien_mua" widget="monetary"/>
                                    <field name="gia_tri_hien_tai" widget="monetary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Đề xuất Thanh lý">
                            <field name="tai_san_ton_kem_ids">
                                <tree decoration-danger="True">
                                    <field name="ma_tai_san"/>
                                    <field name="ten_tai_san"/>
                                    <field name="loai_tai_san_id"/>
                                    <field name="gia_tien_mua" widget="monetary"/>
                                    <field name="gia_tri_hien_tai" widget="monetary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="ghi_chu"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_ai_analytics" model="ir.actions.act_window">
        <field name="name">Phân tích Hiệu quả</field>
        <field name="res_model">ai.tai_san.analytics</field>
        <field name="view_mode">tree,form</field>
    </record>
    
</odoo>
