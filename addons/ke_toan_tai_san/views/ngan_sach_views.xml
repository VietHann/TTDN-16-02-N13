<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ngan_sach_tree" model="ir.ui.view">
        <field name="name">ke.toan.ngan.sach.tree</field>
        <field name="model">ke_toan.ngan_sach</field>
        <field name="arch" type="xml">
            <tree string="Ngân sách">
                <field name="ten_ngan_sach"/>
                <field name="nam"/>
                <field name="quy"/>
                <field name="don_vi_id"/>
                <field name="ngan_sach_du_kien" widget="monetary"/>
                <field name="ngan_sach_da_su_dung" widget="monetary"/>
                <field name="ty_le_su_dung" widget="progressbar"/>
                <field name="trang_thai" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_ngan_sach_form" model="ir.ui.view">
        <field name="name">ke.toan.ngan.sach.form</field>
        <field name="model">ke_toan.ngan_sach</field>
        <field name="arch" type="xml">
            <form string="Ngân sách">
                <header>
                    <field name="trang_thai" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ten_ngan_sach"/>
                            <field name="nam"/>
                            <field name="quy"/>
                        </group>
                        <group>
                            <field name="don_vi_id"/>
                            <field name="nguoi_phu_trach_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="ngan_sach_du_kien" widget="monetary"/>
                            <field name="ngan_sach_da_su_dung" widget="monetary"/>
                        </group>
                        <group>
                            <field name="ngan_sach_con_lai" widget="monetary"/>
                            <field name="ty_le_su_dung" widget="percentage"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết">
                            <field name="chi_tiet_ids">
                                <tree editable="bottom">
                                    <field name="muc_chi"/>
                                    <field name="ten_muc"/>
                                    <field name="ngan_sach_phan_bo" widget="monetary" sum="Tổng"/>
                                    <field name="da_su_dung" widget="monetary"/>
                                    <field name="con_lai" widget="monetary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="ghi_chu"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_ngan_sach" model="ir.actions.act_window">
        <field name="name">Ngân sách</field>
        <field name="res_model">ke_toan.ngan_sach</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu will be added in menu.xml -->
</odoo>
