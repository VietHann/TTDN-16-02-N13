<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Chatbot Interface với Markdown Support -->
    <record id="ai_chatbot_interface_form" model="ir.ui.view">
        <field name="name">ai.chatbot.interface</field>
        <field name="model">ai.chat.history</field>
        <field name="arch" type="xml">
            <form string="AI Chatbot" js_class="ai_chatbot_form">
                <div class="ai-chatbot-root">
                    <div class="ai-chatbot-wrapper">
                        <!-- Header -->
                        <div class="ai-chat-header">
                            <div class="ai-chat-title">
                                <i class="fa fa-robot" title="AI Bot"></i>
                                <span>AI Trợ lý Quản lý Tài sản</span>
                            </div>
                            <div class="ai-chat-status">
                                <span class="status-indicator"></span>
                                <small>Hoạt động</small>
                            </div>
                        </div>

                        <!-- Chat Messages Container -->
                        <div class="ai-chat-messages" id="chat-messages">
                            <div class="welcome-message">
                                <div class="ai-avatar">
                                    <i class="fa fa-robot" title="AI Assistant"></i>
                                </div>
                                <div class="message-content">
                                    <div class="message-bubble ai-message">
                                        <div class="message-markdown">
                                            <p><strong>👋 Xin chào! Tôi là AI Trợ lý của hệ thống Quản lý Tài sản.</strong></p>
                                            <p>Tôi có thể giúp bạn:</p>
                                            <ul>
                                                <li>📊 Tra cứu và thống kê tài sản</li>
                                                <li>👥 Quản lý thông tin nhân viên</li>
                                                <li>🏢 Đặt phòng họp và kiểm tra tình trạng</li>
                                                <li>💡 Tư vấn về bảo trì và khấu hao</li>
                                                <li>📈 Phân tích dữ liệu và báo cáo</li>
                                            </ul>
                                            <p><em>Hãy hỏi tôi bất kỳ câu hỏi nào về hệ thống nhé!</em></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Typing Indicator -->
                        <div class="typing-indicator" id="typing-indicator" style="display: none;">
                            <div class="typing-dots">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>

                        <!-- Chat Input -->
                        <div class="ai-chat-input">
                            <div class="input-container">
                                <textarea
                                    id="chat-input"
                                    placeholder="Nhập câu hỏi của bạn... (Hỗ trợ Markdown)"
                                    rows="1"></textarea>
                                <div class="input-actions">
                                    <button type="button" name="clear_history" id="clear-button" class="btn-action" title="Xóa lịch sử">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                    <button type="button" name="send_message" id="send-button" class="btn-send" title="Gửi tin nhắn">
                                        <i class="fa fa-paper-plane"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hidden fields -->
                <field name="conversation_id" invisible="1"/>
            </form>
            
        </field>
    </record>

    <record id="ai_chatbot_interface_action" model="ir.actions.act_window">
        <field name="name">AI Chatbot</field>
        <field name="res_model">ai.chat.history</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ai_chatbot_interface_form"/>
        <field name="target">new</field>
        <field name="context">{'default_conversation_id': 'chat_new'}</field>
    </record>

</odoo>
