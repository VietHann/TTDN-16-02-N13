<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Phiếu nhập hàng -->
    <record id="seq_phieu_nhap_hang" model="ir.sequence">
        <field name="name">Phiếu nhập hàng</field>
        <field name="code">phieu_nhap_hang</field>
        <field name="prefix">PN-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Sequence for Đặt phòng -->
    <record id="seq_dat_phong" model="ir.sequence">
        <field name="name">Đặt phòng</field>
        <field name="code">dat_phong</field>
        <field name="prefix">DP-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Sequence for Bảo trì phòng họp -->
    <record id="seq_bao_tri_phong_hop" model="ir.sequence">
        <field name="name">Bảo trì phòng họp</field>
        <field name="code">bao_tri_phong_hop</field>
        <field name="prefix">BTPH-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Sequence for Nâng cấp phòng họp -->
    <record id="seq_nang_cap_phong_hop" model="ir.sequence">
        <field name="name">Nâng cấp phòng họp</field>
        <field name="code">nang_cap_phong_hop</field>
        <field name="prefix">NCPH-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>
